FROM node:22-alpine AS build
ENV COREPACK_HOME=/corepack
ENV NODE_OPTIONS=--max-old-space-size=512
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/telegram-admin/package.json apps/telegram-admin/package.json
RUN pnpm install --frozen-lockfile
COPY apps/telegram-admin apps/telegram-admin
RUN pnpm --filter @castaryn/telegram-admin build

FROM nginx:1.27-alpine
COPY apps/telegram-admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/telegram-admin/dist /usr/share/nginx/html/tg
USER nginx
EXPOSE 8080
