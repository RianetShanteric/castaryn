{
  "name": "castaryn",
  "private": true,
  "version": "0.1.6",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "icons": "node scripts/build-icons.mjs",
    "events:audio": "node scripts/build-event-audio.mjs",
    "site:social": "node scripts/build-site-social-card.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm check:desktop && pnpm check:creator && pnpm check:admin && pnpm check:site && pnpm check:telegram",
    "check:desktop": "tsc --noEmit && vitest run --passWithNoTests",
    "check:creator": "pnpm --filter @castaryn/creator-api check",
    "check:admin": "pnpm --filter @castaryn/admin check",
    "check:site": "pnpm --filter @castaryn/site check",
    "check:telegram": "pnpm --filter @castaryn/telegram-admin check",
    "lint": "eslint .",
    "admin:build": "pnpm --filter @castaryn/admin build",
    "site:build": "pnpm --filter @castaryn/site build",
    "telegram:build": "pnpm --filter @castaryn/telegram-admin build",
    "creator:build": "pnpm --filter @castaryn/creator-api build",
    "creator:test": "pnpm --filter @castaryn/creator-api test",
    "preview": "vite preview",
    "security:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/security-check.ps1",
    "release:player:windows": "tauri build --bundles nsis --config src-tauri/tauri.player.conf.json",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed-windows.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
