{
  "name": "@castaryn/creator-api",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:telegram": "node dist/telegram-worker.js",
    "dev:telegram": "tsx watch src/telegram-worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
