NODE_ENV=production
CREATOR_DATABASE_URL=postgresql://castaryn:replace-me@postgres.example:5432/castaryn?sslmode=require
CREATOR_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
CREATOR_AUTH_ISSUER=https://identity.example/
CREATOR_AUTH_AUDIENCE=castaryn-creator-api
CREATOR_REQUIRE_VERIFIED_EMAIL=true
ADMIN_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
ADMIN_AUTH_ISSUER=https://identity.example/
ADMIN_AUTH_AUDIENCE=castaryn-admin-api
ADMIN_ALLOWED_SUBJECTS=replace-with-owner-subject
ADMIN_REQUIRE_MFA=true
ADMIN_ALLOWED_ORIGIN=https://control.example
CREATOR_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TWITCH_CLIENT_ID=replace-me
TWITCH_CLIENT_SECRET=replace-me
TWITCH_REDIRECT_URI=https://api.example/v1/connections/twitch/callback
TWITCH_BOT_REDIRECT_URI=https://api.example/internal/integrations/twitch-bot/callback
TWITCH_BOT_USER_ID=replace-me
TWITCH_EVENTSUB_CALLBACK_URL=https://api.example/webhooks/twitch/eventsub
TWITCH_EVENTSUB_SECRET=replace-with-random-secret
# YouTube is optional -- leave all five unset to run with Twitch only.
# Set none or all five; a partial YouTube config refuses to start.
YOUTUBE_CLIENT_ID=replace-me
YOUTUBE_CLIENT_SECRET=replace-me
YOUTUBE_REDIRECT_URI=https://api.example/v1/connections/youtube/callback
YOUTUBE_BOT_REDIRECT_URI=https://api.example/internal/integrations/youtube-bot/callback
YOUTUBE_BOT_CHANNEL_ID=replace-with-bot-channel-id
# YouTube has no webhook equivalent to Twitch's EventSub -- live chat is
# polled instead. Data API v3 quota is a hard 10,000 units/day by default
# and liveChatMessages.list costs 5 units/call, so polling too often will
# exhaust the daily quota within hours; raise this if you hit 403 quotaExceeded.
YOUTUBE_POLL_INTERVAL_MS=30000
CREATOR_HOST=0.0.0.0
CREATOR_PORT=4310
CREATOR_TRUST_PROXY_HOPS=1
SITE_ANALYTICS_SECRET=replace-with-random-32-byte-or-longer-secret
CASTARYN_SITE_URL=https://castaryn.ru/
CASTARYN_API_HEALTH_URL=https://api.castaryn.ru/healthz
# Telegram is optional, but all three values must be set together.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ADMIN_USER_ID=replace-with-numeric-telegram-user-id
TELEGRAM_MINI_APP_URL=https://control.castaryn.ru/tg/
