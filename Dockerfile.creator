FROM node:26-alpine AS build
ENV COREPACK_HOME=/corepack
ENV NODE_OPTIONS=--max-old-space-size=768
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/creator-api/package.json apps/creator-api/package.json
RUN pnpm install --frozen-lockfile
COPY apps/creator-api apps/creator-api
COPY public/events public/events
RUN pnpm --filter @castaryn/creator-api build \
  && pnpm deploy --legacy --filter @castaryn/creator-api --prod /output

FROM node:26-alpine AS runtime
ENV NODE_ENV=production
RUN addgroup -S castaryn && adduser -S -G castaryn castaryn
WORKDIR /app
COPY --from=build --chown=castaryn:castaryn /output ./
COPY --from=build --chown=castaryn:castaryn /workspace/apps/creator-api/dist ./dist
COPY --from=build --chown=castaryn:castaryn /workspace/apps/creator-api/migrations ./migrations
COPY --from=build --chown=castaryn:castaryn /workspace/public/events ./public/events
USER castaryn
EXPOSE 4310
CMD ["node", "dist/server.js"]
