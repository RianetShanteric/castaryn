FROM node:26-alpine AS build
ENV COREPACK_HOME=/corepack
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
RUN pnpm install --frozen-lockfile
COPY apps/admin apps/admin
ARG VITE_ADMIN_API_URL
ARG VITE_ADMIN_OIDC_AUTHORITY
ARG VITE_ADMIN_OIDC_CLIENT_ID
ARG VITE_ADMIN_OIDC_AUDIENCE
ENV VITE_ADMIN_API_URL=$VITE_ADMIN_API_URL \
    VITE_ADMIN_OIDC_AUTHORITY=$VITE_ADMIN_OIDC_AUTHORITY \
    VITE_ADMIN_OIDC_CLIENT_ID=$VITE_ADMIN_OIDC_CLIENT_ID \
    VITE_ADMIN_OIDC_AUDIENCE=$VITE_ADMIN_OIDC_AUDIENCE
RUN pnpm --filter @castaryn/admin build
# The CSP's connect-src must only allow the real API/OIDC origins this build
# is configured for, not a blanket `https:` -- derive them from the same
# build args the frontend bundle already uses so they can never drift apart.
RUN node -e "process.stdout.write(new URL(process.env.VITE_ADMIN_API_URL).origin)" > /tmp/admin_api_origin \
  && node -e "process.stdout.write(new URL(process.env.VITE_ADMIN_OIDC_AUTHORITY).origin)" > /tmp/admin_oidc_origin \
  && sed \
    -e "s#__ADMIN_API_ORIGIN__#$(cat /tmp/admin_api_origin)#g" \
    -e "s#__ADMIN_OIDC_ORIGIN__#$(cat /tmp/admin_oidc_origin)#g" \
    apps/admin/security-headers.conf.template > apps/admin/security-headers.conf

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build --chown=101:101 --chmod=644 /workspace/apps/admin/security-headers.conf /etc/nginx/security-headers.conf
COPY --chown=101:101 --chmod=644 apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /workspace/apps/admin/dist /usr/share/nginx/html
EXPOSE 8080
